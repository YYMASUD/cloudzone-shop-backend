# ============================================================
# shop-backend environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.
# ============================================================

# ── Spring profile ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopdb
DB_USERNAME=shopuser
DB_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ── JWT RSA keys (file paths or classpath: references) ──────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   mv private.pem public.pem src/main/resources/keys/
JWT_PRIVATE_KEY_LOCATION=classpath:keys/private.pem
JWT_PUBLIC_KEY_LOCATION=classpath:keys/public.pem
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# ── Mail (SMTP) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password

# ── MinIO / Object storage ───────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shop-assets

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── PayPal ──────────────────────────────────────────────────
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── SSLCommerz ──────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=...
SSLCOMMERZ_STORE_PASSWORD=...
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=...

# ── Apple Sign-In ────────────────────────────────────────────
APPLE_CLIENT_ID=com.example.shopapp
APPLE_TEAM_ID=...
APPLE_KEY_ID=...
# Paste the full contents of your .p8 key file (single line, \n-escaped)
APPLE_PRIVATE_KEY=...

# ── CORS (comma-separated browser origins, empty = CORS disabled) ──
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Server ──────────────────────────────────────────────────
PORT=8080
